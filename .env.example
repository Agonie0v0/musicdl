MUSICDL_USER=admin
MUSICDL_PASS=请替换为至少16位的随机密码
MUSICDL_BIND=127.0.0.1
MUSICDL_HOST_PORT=8765
MUSICDL_COOKIE_SECURE=0
# Optional: disable Kugou public audio CDN certificate compatibility retry.
MUSICDL_PREVIEW_STRICT_TLS=0

# Optional: private-chat bots. Leave credentials empty to disable.
# HTTPS origin reachable by phones and WeCom.
MUSICDL_PUBLIC_URL=
MUSICDL_LINK_TTL_SECONDS=86400
# Comma-separated enabled source IDs; empty uses the web settings.
MUSICDL_BOT_SOURCES=
# Telegram: numeric user IDs, NOT usernames. Only private chats are accepted.
MUSICDL_TG_TOKEN=
MUSICDL_TG_ALLOWED_USERS=
# Legacy independent proxy; prefer selecting the project proxy in Web settings.
MUSICDL_TG_PROXY=
# WeCom self-built application: callback URL is PUBLIC_URL + /bot/wecom.
MUSICDL_WECOM_CORP_ID=
MUSICDL_WECOM_AGENT_ID=
MUSICDL_WECOM_SECRET=
MUSICDL_WECOM_TOKEN=
MUSICDL_WECOM_AES_KEY=
MUSICDL_WECOM_ALLOWED_USERS=
